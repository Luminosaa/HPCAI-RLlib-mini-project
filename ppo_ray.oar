#!/bin/bash

#OAR -q default
#OAR -l cpu=25,walltime=48:00:00
#OAR -p cluster='dahu'
#OAR -O ray_ppo_cpu_%jobid%.out
#OAR -E ray_ppo_cpu_%jobid%.err

# System environment
source /etc/profile
module load python/3.10

# Activate your virtual environment
source ~/ray_env/bin/activate

# Display node info
hostname
echo "CPUs available:"
nproc

export AIR_VERBOSITY=0
export RAY_METRICS_EXPORT_INTERVAL_S=0
export RAY_DASHBOARD_ENABLE=0
export RAY_LOG_TO_STDERR=1

ray stop --force
ray start --head --num-cpus=25

# Run training
python train.py

